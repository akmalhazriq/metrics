# ── Required ──────────────────────────────────────────────────────────
# Postgres connection string. Used by src/db/index.ts and drizzle.config.ts.
# Local dev example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metrics_bi
# Production (Neon / Supabase) — paste the pooled connection string from
# your provider dashboard. Must include ?sslmode=require for Neon:
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/metrics_bi?sslmode=require

# ── Optional ──────────────────────────────────────────────────────────
# Port the server listens on. The Nitro output respects PORT (or NITRO_PORT).
# Dev default is 5000 via vite.config.ts; production default is 3000.
# Most hosts (Railway, Render, Fly) inject PORT automatically — leave unset
# locally and the default applies.
# PORT=5000

# ── Production ───────────────────────────────────────────────────────
# Set to "production" on the host. Enables production checks in src/db/index.ts
# (requires DATABASE_URL, validates connection) and marks the build as prod.
# Railway / Render set this automatically in their Node preset; for manual
# deploys add it in the host's env-var dashboard.
# NODE_ENV=production
